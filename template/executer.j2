## EXAMPLES

### Example 1: High-Level Task
**Input Task**: "research_complexity_theory" (160 hours estimated)

**Response**:
```json
{
  "classification": "DECOMPOSE_TASK",
  "task_id": "research_complexity_theory",
  "assessment": {
    "executability": "compound",
    "requires_decomposition": true,
    "information_needed": "current system state, available resources"
  },
  "decomposition": {
    "subtasks": [
      {
        "id": "check_internet_connection",
        "type": "information_gathering",
        "description": "Verify internet connectivity for online research",
        "inputs": [],
        "outputs": ["connection_status"],
        "depends_on": [],
        "validation": "Successfully load a webpage"
      },
      {
        "id": "identify_research_sources",
        "type": "information_gathering", 
        "description": "Find available textbooks, papers, and online resources",
        "inputs": ["connection_status"],
        "outputs": ["available_sources"],
        "depends_on": ["check_internet_connection"],
        "validation": "List of accessible sources compiled"
      },
      {
        "id": "open_research_application",
        "type": "primitive",
        "description": "Launch web browser or PDF reader for research",
        "inputs": ["available_sources"],
        "outputs": ["research_environment_ready"],
        "depends_on": ["identify_research_sources"],
        "validation": "Application successfully opened"
      },
      {
        "id": "begin_systematic_reading",
        "type": "compound",
        "description": "Start reading complexity theory materials systematically",
        "inputs": ["research_environment_ready"],
        "outputs": ["initial_knowledge_gained"],
        "depends_on": ["open_research_application"],
        "validation": "First chapter/paper completed"
      }
    ],
    "execution_order": ["check_internet_connection", "identify_research_sources", "open_research_application", "begin_systematic_reading"],
    "error_handling": {
      "common_failures": ["no_internet", "resources_not_found", "application_crash"],
      "recovery_actions": ["check_network_settings", "find_offline_resources", "restart_application"]
    }
  }
}
```

